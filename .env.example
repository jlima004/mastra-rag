# E1 runtime: server-side rag_app ONLY; Session Pooler port 5432, full TLS verification.
# Password must be percent-encoded locally, never committed, logged or pasted into chat.
# Use a private runtime environment secret, not an admin/database owner credential.
POSTGRES_CONNECTION_STRING=postgresql://rag_app.lmocjhpajhxegzobydau:<URL_ENCODED_RAG_APP_PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=verify-full

# H7 operator-only: configure only as a server-side secret. Use openssl rand -hex 32 privately.
# Do not place SUPABASE_DB_PASSWORD in the Mastra application runtime.
# OPENAI_API_KEY is not required until the separately approved H11 paid-provider gate.
RAG_SERVER_API_TOKEN=
# Mastra Cloud injects TURSO_DATABASE_URL and TURSO_AUTH_TOKEN from hosted Turso.
# Local runtime storage defaults to ignored file:./mastra.db.

# Required CA for hosted runtime (server-side secret), stored as a private server-side
# environment variable. Generate from the verified Supabase certificate file:
# base64 -w 0 "$HOME/.config/mastra-rag/supabase-ca.crt"
# Do not paste the value into Git, chats, screenshots or PR comments.
# Local operator sessions may continue using NODE_EXTRA_CA_CERTS.
SUPABASE_CA_CERT_BASE64=
