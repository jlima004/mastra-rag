# Server-only PostgreSQL URL. Copy your Session Pooler URI from Supabase > Connect.
# Percent-encode reserved characters in the password. Port 5432 and TLS are required.
# Replace placeholders; never commit actual secrets or expose this URI to browsers.
POSTGRES_CONNECTION_STRING=postgresql://postgres.lmocjhpajhxegzobydau:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require

# Configure only as a server-side secret. Use openssl rand -hex 32 privately.
RAG_SERVER_API_TOKEN=
# Mastra Cloud injects TURSO_DATABASE_URL and TURSO_AUTH_TOKEN from hosted Turso.
# Local runtime storage defaults to ignored file:./mastra.db.

# Optional explicit PostgreSQL CA for Mastra Cloud, stored as a private server-side
# environment variable. Generate from the verified Supabase certificate file:
# base64 -w 0 "$HOME/.config/mastra-rag/supabase-ca.crt"
# Do not paste the value into Git, chats, screenshots or PR comments.
# If unset locally, NODE_EXTRA_CA_CERTS remains supported.
SUPABASE_CA_CERT_BASE64=
